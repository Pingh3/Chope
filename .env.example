# Copy to a file OUTSIDE this OneDrive-synced folder (e.g. C:\Users\<you>\.chope-env) and fill in.
# Never commit the filled-in file. .gitignore already blocks .env* inside the repo.

# --- Todoist (server-side sync + cleanup script) ---
TODOIST_API_TOKEN=
TODOIST_PROJECT_NAME=Chope
TODOIST_OWNER=Victor
CHOPE_TZ=Asia/Singapore

# --- Scheduled reconcile (any long random string; used as "Authorization: Bearer <value>") ---
CRON_SECRET=

# --- Firebase service account (already configured in Vercel for api/focus.js) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
