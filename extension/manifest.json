{
  "manifest_version": 3,
  "name": "Add to Chope",
  "version": "1.0.0",
  "description": "Turn the Gmail email you're reading into a Chope task in one click.",
  "minimum_chrome_version": "110",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Add this email to Chope",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["identity", "activeTab", "scripting", "storage"],
  "host_permissions": ["https://chope.vercel.app/*"],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Add this email to Chope"
    }
  }
}
